{
  "name": "voltran",
  "version": "1.0.0",
  "private": true,
  "description": "Local multi-agent session and terminal orchestrator",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Onur Ravli <onur@onurravli.com>",
  "homepage": "https://github.com/onurravli/voltran#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onurravli/voltran.git"
  },
  "bugs": {
    "url": "https://github.com/onurravli/voltran/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/shared",
    "packages/daemon",
    "packages/web"
  ],
  "bin": {
    "voltran": "bin/voltran.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "up": "node bin/voltran.mjs up",
    "build": "npm run build -w @voltran/web",
    "dev:daemon": "VOLTRAN_DEV=1 node --watch packages/daemon/src/main.ts",
    "dev:web": "npm run dev -w @voltran/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/daemon && tsc -p packages/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
